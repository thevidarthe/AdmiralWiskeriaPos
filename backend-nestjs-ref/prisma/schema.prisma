// ════════════════════════════════════════════════════════════
// Admiral Pro — Prisma Schema
// Multi-tenant POS + CRM + Inventario + WhatsApp + QR
// ════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════
// TENANCY
// ════════════════════════════════════════════════════════════

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  config    Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches    Branch[]
  users       User[]
  customers   Customer[]
  categories  Category[]
  products    Product[]
  promotions  PromotionRule[]
  coupons     Coupon[]
  campaigns   Campaign[]
  templates   MessageTemplate[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  timezone  String   @default("America/Bogota")
  settings  Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zones      Zone[]
  tables     Table[]
  shifts     Shift[]
  sales      Sale[]
  stockItems StockItem[]
  movements  InventoryMovement[]

  @@index([tenantId])
  @@map("branches")
}

// ════════════════════════════════════════════════════════════
// USUARIOS Y AUTORIZACIÓN
// ════════════════════════════════════════════════════════════

enum UserRole {
  ADMIN
  MANAGER
  BARISTA
  WAITER
  CASHIER
}

model User {
  id             String    @id @default(uuid())
  tenantId       String
  email          String
  name           String
  phone          String?
  avatarUrl      String?
  passwordHash   String
  pinHash        String
  role           UserRole  @default(WAITER)
  active         Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shifts Shift[]
  sales  Sale[]

  @@unique([tenantId, email])
  @@index([tenantId, active])
  @@map("users")
}

// ════════════════════════════════════════════════════════════
// ZONAS Y MESAS
// ════════════════════════════════════════════════════════════

enum ZoneType {
  BAR
  FLOOR
  VIP
  TERRACE
}

model Zone {
  id       String   @id @default(uuid())
  tenantId String
  branchId String
  name     String
  type     ZoneType @default(FLOOR)
  active   Boolean  @default(true)

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables Table[]

  @@index([tenantId, branchId])
  @@map("zones")
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

model Table {
  id       String      @id @default(uuid())
  tenantId String
  branchId String
  zoneId   String
  number   String
  capacity Int         @default(4)
  status   TableStatus @default(FREE)

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  zone    Zone     @relation(fields: [zoneId], references: [id])
  qrCodes QrCode[]
  sales   Sale[]

  @@unique([branchId, number])
  @@index([tenantId, branchId, status])
  @@map("tables")
}

// ════════════════════════════════════════════════════════════
// QR
// ════════════════════════════════════════════════════════════

model QrCode {
  id        String    @id @default(uuid())
  tenantId  String
  branchId  String
  tableId   String
  token     String    @unique @default(uuid())
  svgData   String?
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("qr_codes")
}

// ════════════════════════════════════════════════════════════
// CATEGORÍAS Y PRODUCTOS
// ════════════════════════════════════════════════════════════

model Category {
  id        String   @id @default(uuid())
  tenantId  String
  parentId  String?
  name      String
  slug      String
  icon      String?
  color     String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, active, sortOrder])
  @@map("categories")
}

enum ProductUnit {
  UNIT
  ML
  OZ
  GRAM
  BOTTLE
  GLASS
  SHOT
}

model Product {
  id             String      @id @default(uuid())
  tenantId       String
  categoryId     String
  name           String
  description    String?
  sku            String?
  barcode        String?
  basePrice      Decimal     @db.Decimal(12, 2)
  costPrice      Decimal?    @db.Decimal(12, 2)
  taxRate        Decimal     @default(0.19) @db.Decimal(5, 4)
  unit           ProductUnit @default(UNIT)
  unitSize       Decimal?    @db.Decimal(10, 2)
  alcoholVolume  Decimal?    @db.Decimal(5, 2)
  imageUrl       String?
  isCombo        Boolean     @default(false)
  comboItems     Json?
  trackInventory Boolean     @default(true)
  minStock       Decimal?    @db.Decimal(10, 2)
  available      Boolean     @default(true)
  sortOrder      Int         @default(0)
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category               @relation(fields: [categoryId], references: [id])
  saleItems  SaleItem[]
  stockItems StockItem[]
  movements  InventoryMovement[]
  promotions PromotionRuleProduct[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, available])
  @@map("products")
}

// ════════════════════════════════════════════════════════════
// INVENTARIO
// ════════════════════════════════════════════════════════════

model StockItem {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  productId String
  quantity  Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([tenantId, branchId])
  @@map("stock_items")
}

enum MovementType {
  IN_PURCHASE
  IN_RETURN
  IN_ADJUSTMENT
  IN_TRANSFER
  OUT_SALE
  OUT_WASTE
  OUT_TRANSFER
  OUT_ADJUSTMENT
  COUNT
}

model InventoryMovement {
  id            String       @id @default(uuid())
  tenantId      String
  branchId      String
  productId     String
  movementType  MovementType
  quantity      Decimal      @db.Decimal(12, 2)
  unitCost      Decimal?     @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  notes         String?
  createdBy     String?
  createdAt     DateTime     @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, productId, createdAt])
  @@map("inventory_movements")
}

// ════════════════════════════════════════════════════════════
// CLIENTES Y LEALTAD
// ════════════════════════════════════════════════════════════

enum LoyaltyLevel {
  CLASSIC
  SILVER
  GOLD
  PLATINUM
}

model Customer {
  id            String       @id @default(uuid())
  tenantId      String
  name          String
  phone         String
  email         String?
  birthday      DateTime?
  loyaltyLevel  LoyaltyLevel @default(CLASSIC)
  pointsBalance Int          @default(0)
  totalSpent    Decimal      @default(0) @db.Decimal(14, 2)
  visitCount    Int          @default(0)
  lastVisitAt   DateTime?
  notes         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales        Sale[]
  consents     WhatsAppConsent[]
  loyaltyTx    LoyaltyTransaction[]
  messageLogs  MessageLog[]

  @@unique([tenantId, phone])
  @@index([tenantId, loyaltyLevel])
  @@map("customers")
}

model WhatsAppConsent {
  id           String    @id @default(uuid())
  customerId   String
  type         String
  channel      String
  active       Boolean   @default(true)
  termsVersion String    @default("v1")
  consentedAt  DateTime  @default(now())
  revokedAt    DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type, active])
  @@map("whatsapp_consents")
}

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  customerId  String
  saleId      String?
  pointsDelta Int
  reason      String
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id])

  @@index([customerId, createdAt])
  @@map("loyalty_transactions")
}

// ════════════════════════════════════════════════════════════
// TURNOS Y VENTAS
// ════════════════════════════════════════════════════════════

model Shift {
  id         String    @id @default(uuid())
  tenantId   String
  branchId   String
  userId     String
  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  openFloat  Decimal   @default(0) @db.Decimal(12, 2)
  closeFloat Decimal?  @db.Decimal(12, 2)
  notes      String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  sales  Sale[]

  @@index([tenantId, branchId, openedAt])
  @@map("shifts")
}

enum SaleStatus {
  OPEN
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum SaleSource {
  POS
  QR
  WAITER
}

model Sale {
  id            String     @id @default(uuid())
  tenantId      String
  branchId      String
  tableId       String?
  shiftId       String?
  userId        String?
  customerId    String?
  name          String?
  status        SaleStatus @default(OPEN)
  source        SaleSource @default(POS)
  subtotal      Decimal    @default(0) @db.Decimal(12, 2)
  discountTotal Decimal    @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal    @default(0) @db.Decimal(12, 2)
  tipAmount     Decimal    @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal    @default(0) @db.Decimal(12, 2)
  notes         String?
  openedAt      DateTime   @default(now())
  closedAt      DateTime?

  branch    Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table     Table?               @relation(fields: [tableId], references: [id])
  shift     Shift?               @relation(fields: [shiftId], references: [id])
  user      User?                @relation(fields: [userId], references: [id])
  customer  Customer?            @relation(fields: [customerId], references: [id])
  items     SaleItem[]
  payments  Payment[]
  loyaltyTx LoyaltyTransaction[]

  @@index([tenantId, branchId, status])
  @@index([tenantId, openedAt])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id           String   @id @default(uuid())
  tenantId     String
  saleId       String
  productId    String
  productName  String
  quantity     Decimal  @db.Decimal(10, 2)
  unitPrice    Decimal  @db.Decimal(12, 2)
  discount     Decimal  @default(0) @db.Decimal(12, 2)
  taxRate      Decimal  @default(0.19) @db.Decimal(5, 4)
  lineTotal    Decimal  @db.Decimal(12, 2)
  promoApplied String?
  notes        String?
  createdAt    DateTime @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([tenantId, productId])
  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  NEQUI
  DAVIPLATA
  PSE
  MIXED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

model Payment {
  id        String        @id @default(uuid())
  tenantId  String
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  status    PaymentStatus @default(COMPLETED)
  reference String?
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("payments")
}

// ════════════════════════════════════════════════════════════
// PROMOCIONES Y CUPONES
// ════════════════════════════════════════════════════════════

enum PromoType {
  HAPPY_HOUR
  COMBO
  FIXED_DISCOUNT
  PERCENTAGE_DISCOUNT
}

model PromotionRule {
  id             String    @id @default(uuid())
  tenantId       String
  name           String
  description    String?
  type           PromoType
  discountValue  Decimal   @db.Decimal(8, 2)
  startTime      String?
  endTime        String?
  daysOfWeek     Int[]     @default([])
  minOrderAmount Decimal?  @db.Decimal(12, 2)
  loyaltyLevels  String[]  @default([])
  stackable      Boolean   @default(false)
  active         Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products PromotionRuleProduct[]

  @@index([tenantId, active])
  @@map("promotion_rules")
}

model PromotionRuleProduct {
  ruleId    String
  productId String

  rule    PromotionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([ruleId, productId])
  @@map("promotion_rule_products")
}

model Coupon {
  id           String    @id @default(uuid())
  tenantId     String
  code         String
  discountType String
  value        Decimal   @db.Decimal(10, 2)
  maxUses      Int?
  usedCount    Int       @default(0)
  startsAt     DateTime?
  expiresAt    DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("coupons")
}

// ════════════════════════════════════════════════════════════
// WHATSAPP
// ════════════════════════════════════════════════════════════

model MessageTemplate {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  waId       String
  category   String
  language   String   @default("es")
  components Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([tenantId, active])
  @@map("message_templates")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model Campaign {
  id             String         @id @default(uuid())
  tenantId       String
  branchId       String?
  name           String
  templateId     String?
  segmentQuery   Json
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  totalSent      Int            @default(0)
  totalDelivered Int            @default(0)
  totalRead      Int            @default(0)
  totalFailed    Int            @default(0)
  createdAt      DateTime       @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template MessageTemplate? @relation(fields: [templateId], references: [id])
  logs     MessageLog[]

  @@index([tenantId, status])
  @@map("campaigns")
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  OPT_OUT
}

model MessageLog {
  id          String        @id @default(uuid())
  campaignId  String?
  customerId  String
  waMessageId String?
  phone       String
  status      MessageStatus @default(QUEUED)
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failReason  String?
  createdAt   DateTime      @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, sentAt])
  @@index([campaignId, status])
  @@map("message_logs")
}

// ════════════════════════════════════════════════════════════
// AUDITORÍA
// ════════════════════════════════════════════════════════════

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, userId])
  @@map("audit_logs")
}
