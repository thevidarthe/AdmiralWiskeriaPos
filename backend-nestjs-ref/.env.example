# ════════════════════════════════════════════════════════════
# Admiral Pro — Variables de entorno
# Copia este archivo a `.env` y reemplaza los valores
# NUNCA comitees `.env` al repositorio
# ════════════════════════════════════════════════════════════

# ─── Aplicación ────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME="Admiral Whiskería Pro"
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ─── Base de datos PostgreSQL ──────────────────────────────
# Usar `openssl rand -base64 24` para generar password seguro
DATABASE_URL="postgresql://admiral:CHANGE_ME_LOCAL_DEV@localhost:5432/admiral_pro?schema=public"

# ─── Redis (cola WhatsApp, caché, rate limit) ──────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_LOCAL_DEV
REDIS_DB=0

# ─── JWT — DEBE ser cadena aleatoria >=64 chars ────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=GENERATE_WITH_openssl_rand_base64_64_THIS_IS_NOT_SAFE_IN_PRODUCTION
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ─── Throttling (rate limit global) ────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# ─── Multi-tenant defecto (seed) ───────────────────────────
DEFAULT_TENANT_SLUG=admiral
DEFAULT_TENANT_NAME="Admiral Whiskería"

# ─── WhatsApp Business API (Meta) ──────────────────────────
# Obtener en: https://developers.facebook.com/apps/
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=GENERATE_RANDOM_STRING
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ─── Subida de archivos ────────────────────────────────────
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIR=./uploads
