# ════════════════════════════════════════════════════════════
# Admiral Pro (Go) — Variables de entorno
# Copia este archivo a `.env` y reemplaza los valores
# NUNCA comitees `.env` al repositorio
# ════════════════════════════════════════════════════════════

# ─── Aplicación ────────────────────────────────────────────
APP_ENV=development
APP_PORT=4000
APP_NAME="Admiral Whiskería Pro"
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ─── Base de datos PostgreSQL ──────────────────────────────
# Genera password seguro: openssl rand -base64 24
DATABASE_URL=postgres://admiral:CHANGE_ME_LOCAL_DEV@localhost:5432/admiral_pro?sslmode=disable

# ─── Redis (colas WhatsApp + rate limit) ───────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=CHANGE_ME_LOCAL_DEV
REDIS_DB=0

# ─── JWT — DEBE ser cadena aleatoria >=32 chars ────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=GENERATE_WITH_openssl_rand_base64_64_THIS_IS_NOT_SAFE_IN_PROD
JWT_EXPIRES_HOURS=8

# ─── Rate limit global (peticiones por minuto por IP) ──────
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_AUTH_MAX=10

# ─── Multi-tenant defecto (seed) ───────────────────────────
DEFAULT_TENANT_SLUG=admiral
DEFAULT_TENANT_NAME=Admiral Whiskería
DEFAULT_BRANCH_SLUG=sandona

# ─── Simulación de Clima (solo dev/staging) ────────────────
# En producción este endpoint está deshabilitado.
SIMULATE_WEATHER_ENABLED=false

# ─── WhatsApp Business API (Meta) ──────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=GENERATE_RANDOM_STRING
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ─── Subidas de archivos ───────────────────────────────────
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5

# ─── Datos de Siembra (Seed - Opcionales con fallbacks) ─────
SEED_ADMIN_PASSWORD=Admiral2026!
SEED_ADMIN_PIN=1234
SEED_BARISTA_PASSWORD=Barista2026!
SEED_BARISTA_PIN=1111
SEED_WAITER_PASSWORD=Mesero2026!
SEED_WAITER_PIN=2222
SEED_CAMILA_PASSWORD=Mesero2026!
SEED_CAMILA_PIN=2233
SEED_CASHIER_PASSWORD=Cajero2026!
SEED_CASHIER_PIN=3333

