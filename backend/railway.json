{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "go build -ldflags='-s -w' -o ./bin/admiral-api ./cmd/api && go build -o ./bin/admiral-migrate ./cmd/migrate"
  },
  "deploy": {
    "startCommand": "./bin/admiral-migrate up && ./bin/admiral-api",
    "healthcheckPath": "/api/v1/health/ping",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
